{
  "name": "dsh-decision-workbench",
  "version": "0.2.1",
  "description": "Decision Workbench for DeepSeek Harness: /decision opens a right sidebar panel that turns a spec's open decisions into per-question choices, explained and worked through with an independent decision assistant session.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src",
    "docs",
    "example",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "decision",
    "spec",
    "clarify",
    "right-sidebar",
    "human-in-the-loop"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node --check src/index.js && node --check src/client.js && node --check src/shared.js",
    "test": "node --test \"test/*.test.js\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    }
  }
}
